{
  "name": "@honeyrizons/honeypot",
  "private": true,
  "scripts": {
    "build": "cd beelzebub && go build -o ../bin/beelzebub .",
    "dev": "mkdir -p ../../logs && BEELZEBUB=./bin/beelzebub ./scripts/supervise.sh",
    "start": "mkdir -p ../../logs && BEELZEBUB=./bin/beelzebub ./scripts/supervise.sh",
    "validate": "./bin/beelzebub validate -c config/beelzebub.yaml -s config/services/ && ./bin/beelzebub validate -c config/annex.yaml -s config/lures/",
    "attack": "./scripts/attack.sh",
    "seed": "bun scripts/seed-demo.ts",
    "attack:agent": "bun scripts/agent-attack.ts",
    "typecheck": "tsc",
    "attack:claude": "bun scripts/claude-agent.ts",
    "attack:lures": "./scripts/attack-lures.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@honeyrizons/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.0"
  }
}
