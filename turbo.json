{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "bin/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "dependsOn": [
        "@honeyrizons/honeypot#build"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "attack": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "attack:agent": {
      "cache": false
    },
    "attack:claude": {
      "cache": false
    },
    "attack:lures": {
      "cache": false
    }
  }
}
