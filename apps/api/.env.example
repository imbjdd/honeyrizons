# Analyst agent (automatic session triage + threat brief). Leave empty for local rules only.
OPENAI_API_KEY=
# Small model by default to keep each analysis cheap.
OPENAI_MODEL=gpt-5.4-nano
# Hard cap on LLM analyses per hour; extra sessions wait in the queue.
OPENAI_MAX_ANALYSES_PER_HOUR=40
# Where the honeypot sits on the attack map, as "lat,lon".
HONEYPOT_LOCATION=48.8566,2.3522
# City planner: auto builds lures itself, propose waits for you to apply its suggestions from the city, off disables it.
CITY_PLANNER=auto
