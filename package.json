{
  "name": "honeyrizons",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "attack": "turbo run attack --filter=@honeyrizons/honeypot",
    "seed": "turbo run seed --filter=@honeyrizons/honeypot",
    "attack:agent": "turbo run attack:agent --filter=@honeyrizons/honeypot",
    "attack:claude": "turbo run attack:claude --filter=@honeyrizons/honeypot",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
